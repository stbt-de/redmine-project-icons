<%# Administration → Plugins → Project Icons: wo Icons erscheinen %>
<p><%= l(:text_project_icons_settings_intro) %></p>

<% RedmineProjectIcons::Display::LOCATIONS.each do |location| %>
  <p>
    <label for="settings_show_in_<%= location %>"><%= l(:"field_project_icons_show_in_#{location}") %></label>
    <%= hidden_field_tag "settings[show_in_#{location}]", '0', id: nil %>
    <%= check_box_tag "settings[show_in_#{location}]", '1', @settings["show_in_#{location}"].to_s == '1',
                      id: "settings_show_in_#{location}" %>
    <em class="info"><%= l(:"text_project_icons_show_in_#{location}") %></em>
  </p>
<% end %>
